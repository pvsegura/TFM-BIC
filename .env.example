# Environment variable names only — no real values. Never commit a populated .env.
# See docs/deployment/environments.md.

# App (read by packages/config — see packages/config/src/env/load-env.ts).
# All three are optional; defaults shown are what apps/api falls back to.
NODE_ENV=development
PORT=3000
DEFAULT_LANGUAGE=pl

# Languages & Content (M5, ADR-018). Optional: folder that holds languages/<id>/... Unset = the
# repository's own content/ folder. The API validates it at startup and refuses to start if invalid.
# CONTENT_DIR=

# --- Below: read by M3 (Authentication) code — see docs/adr/adr-005/006/014 ---

# Database (Postgres connection string — Neon in production, local Docker Postgres in dev/CI;
# see docs/adr/adr-005-database.md). Required in all environments except NODE_ENV=test, which
# uses an in-process PGlite instance instead.
DATABASE_URL=

# Auth — HMAC key used to sign (not encrypt) the session cookie value; see
# docs/adr/adr-006-authentication.md. Required in production/staging, at least 32 characters (M16).
# Generate with e.g. `openssl rand -base64 32`. Never reuse across environments.
AUTH_SESSION_SECRET=

# App base URL — used to build verification/reset links and to validate the Origin header on
# state-changing requests (CSRF defense in depth, see ADR-006). Required and https in
# staging/production (M16); defaults to http://localhost:5173 in development/test.
APP_BASE_URL=

# Reverse proxies allowed to set X-Forwarded-For (M16, ADR-027): comma-separated IPs/CIDR ranges,
# e.g. 10.0.0.0/8. Empty = trust none. Never "true" or a hop count (clients could spoof their address).
TRUST_PROXY=

# Email (M14, docs/adr/adr-014-email.md + adr-025-email-newsletter.md). "fake" is the ONLY accepted
# value and the default: messages are kept in memory and nothing is ever sent — in development, CI,
# E2E and (until a real provider is selected, ADR-014 PENDING) every other environment. No provider
# API key is read yet.
EMAIL_PROVIDER=fake
# Optional. Sender and reply-to on every email; no line breaks allowed.
# EMAIL_FROM=TFM-BIC <no-reply@example.invalid>
# EMAIL_REPLY_TO=
# Secret (≥ 32 chars) that signs newsletter unsubscribe links. Required in staging/production; dev/test
# use an ephemeral per-process value. Rotating it breaks the unsubscribe links in already-sent newsletters.
EMAIL_LINK_SECRET=

# Audio generation (M12, docs/adr/adr-013-audio-generation.md). "fake" (the default, and what
# tests/CI/Playwright always use) returns a deterministic WAV tone — never calls Gemini. "gemini"
# selects GeminiAudioProvider and requires GEMINI_API_KEY; it is refused when NODE_ENV=test. Keep
# "fake" until ADR-013's provider-terms decision (under-18 use, paid tier in the EEA) is made.
AUDIO_GENERATION_PROVIDER=fake
# Secret — set only in the host's secret store, never in a committed file.
GEMINI_API_KEY=
# Optional. Default: gemini-3.8-flash-tts (GA, verified 2026-09-25).
# GEMINI_TTS_MODEL=
# Optional. Characters per clip, 1–500. Default: 300.
# AUDIO_GENERATION_MAX_TEXT_LENGTH=

# Video generation (M11, docs/adr/adr-012-video-generation.md). "fake" (the default, and what
# tests/CI always use) selects a real, committed in-memory adapter — never Hyperframes.
# "hyperframes" selects HyperframesCliProvider, which shells out to `npx hyperframes render`
# against a project under content/video-scripts/ — implemented against Hyperframes' verified,
# no-auth-required local CLI, but NOT executed end-to-end in this environment (see
# content/video-scripts/README.md); it needs Node 22+, FFmpeg and headless Chrome on the host,
# none of which are confirmed available until ADR-015 (hosting) is resolved. No API key: local
# self-hosted rendering needs no credential.
VIDEO_GENERATION_PROVIDER=fake

# Reserved for when apps/web calls apps/api directly (not wired in M1)
API_BASE_URL=
WEB_BASE_URL=
