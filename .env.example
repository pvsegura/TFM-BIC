# Environment variable names only — no real values. Never commit a populated .env.
# See docs/deployment/environments.md.

# App (read by packages/config — see packages/config/src/env/load-env.ts).
# All three are optional; defaults shown are what apps/api falls back to.
NODE_ENV=development
PORT=3000
DEFAULT_LANGUAGE=pl

# --- Below: read by M3 (Authentication) code — see docs/adr/adr-005/006/014 ---

# Database (Postgres connection string — Neon in production, local Docker Postgres in dev/CI;
# see docs/adr/adr-005-database.md). Required in all environments except NODE_ENV=test, which
# uses an in-process PGlite instance instead.
DATABASE_URL=

# Auth — HMAC key used to sign (not encrypt) the session cookie value; see
# docs/adr/adr-006-authentication.md. Required in production/staging. Generate with e.g.
# `openssl rand -base64 32`. Never reuse across environments.
AUTH_SESSION_SECRET=

# App base URL — used to build verification/reset links and to validate the Origin header on
# state-changing auth requests (CSRF defense in depth, see ADR-006).
APP_BASE_URL=

# Email (documented target provider: Resend — provider account PENDING, see
# docs/adr/adr-014-email.md). Not read by M3 code: development/test use the in-memory email
# adapter. Reserved for when a real ResendEmailService adapter is wired.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# Gemini API (audio generation — see docs/adr/adr-013-audio-generation.md)
GEMINI_API_KEY=

# Hyperframes (video generation — auth requirement UNKNOWN for self-hosted use, see
# docs/adr/adr-012-video-generation.md)
HYPERFRAMES_CONFIG=

# Reserved for when apps/web calls apps/api directly (not wired in M1)
API_BASE_URL=
WEB_BASE_URL=
