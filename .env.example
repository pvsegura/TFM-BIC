# Environment variable names only — no real values. Never commit a populated .env.
# See docs/deployment/environments.md.

# App (read by packages/config — see packages/config/src/env/load-env.ts).
# All three are optional; defaults shown are what apps/api falls back to.
NODE_ENV=development
PORT=3000
DEFAULT_LANGUAGE=pl

# --- Everything below is PENDING and unused by any M1 code (see current-state.md) ---

# Database (provider PENDING — see docs/adr/adr-005-database.md)
DATABASE_URL=

# Auth (session/token mechanism PENDING — see docs/adr/adr-006-authentication.md)
AUTH_SECRET=

# Email (provider PENDING — see docs/adr/adr-014-email.md)
EMAIL_PROVIDER_API_KEY=

# Gemini API (audio generation — see docs/adr/adr-013-audio-generation.md)
GEMINI_API_KEY=

# Hyperframes (video generation — auth requirement UNKNOWN for self-hosted use, see
# docs/adr/adr-012-video-generation.md)
HYPERFRAMES_CONFIG=

# Reserved for when apps/web calls apps/api directly (not wired in M1)
API_BASE_URL=
WEB_BASE_URL=
