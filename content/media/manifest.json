    {
      "key": "lesson:pl-polite-words",
      "content": {
        "type": "lesson",
        "id": "pl-polite-words",
        "languageId": "pl"
      },
      "published": {
        "video": {
          "purpose": "lesson-explanation",
          "url": "pl/lesson/pl-polite-words/video-8aeb4d6159a0.mp4",
          "posterUrl": "pl/lesson/pl-polite-words/poster-8aeb4d6159a0.jpg",
          "captionsUrl": "pl/lesson/pl-polite-words/captions-8aeb4d6159a0.vtt",
          "captionsLanguage": "en",
          "durationSeconds": 112.1,
          "width": 1280,
          "height": 720,
          "narrator": "Anna",
          "transcript": [
            {
              "text": "Please, thank you and sorry. A few short words that make everyday conversations polite.",
              "language": "en"
            },
            {
              "text": "Proszę and dziękuję are among the most useful Polish words.",
              "language": "en"
            },
            {
              "text": "Proszę means please when you ask for something.",
              "language": "en"
            },
            {
              "text": "It also means here you are when you hand something over, and you are welcome when someone thanks you.",
              "language": "en"
            },
            {
              "text": "Dziękuję means thank you.",
              "language": "en"
            },
            {
              "text": "Dziękuję.",
              "language": "pl",
              "translation": "Thank you."
            },
            {
              "text": "Dziękuję bardzo.",
              "language": "pl",
              "translation": "Thank you very much."
            },
            {
              "text": "Proszę.",
              "language": "pl",
              "translation": "Please. Here you are. You are welcome."
            },
            {
              "text": "One word, three uses. The situation tells you which.",
              "language": "en"
            },
            {
              "text": "Przepraszam.",
              "language": "pl",
              "translation": "Sorry. Excuse me."
            },
            {
              "text": "Tak.",
              "language": "pl",
              "translation": "Yes."
            },
            {
              "text": "Nie.",
              "language": "pl",
              "translation": "No."
            },
            {
              "text": "Now it's your turn. Practise with the exercises below the video.",
              "language": "en"
            }
          ]
        },
        "audio": []
      },
      "sourceHash": "605d2ac791eee0d075a6d09f3cb88d2b605b872770a4cfb06dc542bd0c540a2b",
