    {
      "key": "lesson:pl-introducing-yourself",
      "content": {
        "type": "lesson",
        "id": "pl-introducing-yourself",
        "languageId": "pl"
      },
      "published": {
        "video": {
          "purpose": "lesson-explanation",
          "url": "pl/lesson/pl-introducing-yourself/video-2afcbd6dcb78.mp4",
          "posterUrl": "pl/lesson/pl-introducing-yourself/poster-2afcbd6dcb78.jpg",
          "captionsUrl": "pl/lesson/pl-introducing-yourself/captions-2afcbd6dcb78.vtt",
          "captionsLanguage": "en",
          "durationSeconds": 133.34,
          "width": 1280,
          "height": 720,
          "narrator": "Marek",
          "transcript": [
            {
              "text": "Introducing yourself. Say your name, ask someone theirs, and say where you are from.",
              "language": "en"
            },
            {
              "text": "To say your name, use Mam na imię followed by your first name.",
              "language": "en"
            },
            {
              "text": "To say where you are from, use Jestem z followed by the name of the country.",
              "language": "en"
            },
            {
              "text": "The country name changes its ending after z, so for now it is best to learn these sentences as whole phrases.",
              "language": "en"
            },
            {
              "text": "Mam na imię Anna.",
              "language": "pl",
              "translation": "My name is Anna."
            },
            {
              "text": "Jak masz na imię?",
              "language": "pl",
              "translation": "What is your name?"
            },
            {
              "text": "Informal. Speaking to one person you know well, or a child.",
              "language": "en"
            },
            {
              "text": "Jestem z Polski.",
              "language": "pl",
              "translation": "I am from Poland."
            },
            {
              "text": "Jestem z Hiszpanii.",
              "language": "pl",
              "translation": "I am from Spain."
            },
            {
              "text": "Miło mi cię poznać.",
              "language": "pl",
              "translation": "Nice to meet you."
            },
            {
              "text": "Informal. A polite version uses pana (to a man) or panią (to a woman) instead of cię.",
              "language": "en"
            },
            {
              "text": "Anna: Cześć! Mam na imię Anna.",
              "language": "pl",
              "translation": "Hi! My name is Anna."
            },
            {
              "text": "Piotr: Cześć! Jestem Piotr.",
              "language": "pl",
              "translation": "Hi! I am Piotr."
            },
            {
              "text": "Anna: Miło mi cię poznać.",
              "language": "pl",
              "translation": "Nice to meet you."
            },
            {
              "text": "Piotr: Mnie też.",
              "language": "pl",
              "translation": "Me too."
            },
            {
              "text": "Now it's your turn. Practise with the exercises below the video.",
              "language": "en"
            }
          ]
        },
        "audio": []
      },
      "sourceHash": "30b3d0756e7af50852d3e419506783e41a33533557864025b3a849d22ee61686",
