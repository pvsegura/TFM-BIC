    {
      "key": "lesson:pl-greetings",
      "content": {
        "type": "lesson",
        "id": "pl-greetings",
        "languageId": "pl"
      },
      "published": {
        "video": {
          "purpose": "lesson-explanation",
          "url": "pl/lesson/pl-greetings/video-bced083ca069.mp4",
          "posterUrl": "pl/lesson/pl-greetings/poster-bced083ca069.jpg",
          "captionsUrl": "pl/lesson/pl-greetings/captions-bced083ca069.vtt",
          "captionsLanguage": "en",
          "durationSeconds": 119.86,
          "width": 1280,
          "height": 720,
          "narrator": "Anna",
          "transcript": [
            {
              "text": "Greetings and goodbyes. Polite and informal ways to say hello and goodbye in Polish.",
              "language": "en"
            },
            {
              "text": "Polish has more than one way to greet people, and the choice depends on how formal the situation is.",
              "language": "en"
            },
            {
              "text": "Dzień dobry is polite and works with people you do not know well.",
              "language": "en"
            },
            {
              "text": "Cześć is informal: it is used with friends and family, both to say hello and to say goodbye.",
              "language": "en"
            },
            {
              "text": "Dzień dobry.",
              "language": "pl",
              "translation": "Good day; hello."
            },
            {
              "text": "Polite. Used during the day.",
              "language": "en"
            },
            {
              "text": "Dobry wieczór.",
              "language": "pl",
              "translation": "Good evening."
            },
            {
              "text": "Polite. Used in the evening.",
              "language": "en"
            },
            {
              "text": "Cześć!",
              "language": "pl",
              "translation": "Hi! Bye!"
            },
            {
              "text": "Informal. For friends and family.",
              "language": "en"
            },
            {
              "text": "Do widzenia.",
              "language": "pl",
              "translation": "Goodbye."
            },
            {
              "text": "Polite.",
              "language": "en"
            },
            {
              "text": "Na razie!",
              "language": "pl",
              "translation": "See you! Bye!"
            },
            {
              "text": "Informal.",
              "language": "en"
            },
            {
              "text": "Dobranoc.",
              "language": "pl",
              "translation": "Good night."
            },
            {
              "text": "Said when saying goodnight, not as a general goodbye.",
              "language": "en"
            },
            {
              "text": "Now it's your turn. Practise with the exercises below the video.",
              "language": "en"
            }
          ]
        },
        "audio": []
      },
      "sourceHash": "1fc3e0eb8e4bf731e3e3137c4607effc474854815aaf482d6aa512d6a033edb4",
      "narratorId": "anna",
