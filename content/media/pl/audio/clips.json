    "narratorId": "marek",
    "fingerprint": "e42f0dd317e9841c",
    "createdAt": "2026-10-01T07:41:11.050Z"
  },
  "b5f769ad3599e219": {
    "path": "pl/audio/anna/b5f769ad3599e219.m4a",
    "durationSeconds": 5.04,
    "text": "Some Polish letters and letter pairs are new for English speakers.",
