    "createdAt": "2026-10-01T07:19:17.979Z"
  },
  "b52f8590d1899da4": {
    "path": "pl/audio/marek/b52f8590d1899da4.m4a",
    "durationSeconds": 7.76,
    "text": "A bare noun can therefore mean a cat or the cat, and the meaning comes from the situation.",
