  "b15f5e056337d0c6": {
    "path": "pl/audio/anna/b15f5e056337d0c6.m4a",
    "durationSeconds": 8.04,
    "text": "A first look at Polish spelling and sounds. A few letters and letter pairs that are new to English speakers.",
