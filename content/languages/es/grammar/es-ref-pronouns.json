        {
          "text": "¿Vienes conmigo?",
          "translation": "Pójdziesz ze mną?",
          "note": "Con + mí / ti = conmigo, contigo."
        },
        {
          "text": "Este regalo es para ti.",
          "translation": "Ten prezent jest dla ciebie.",
          "note": "Po przyimku: mí z kreską (ja), mi bez kreski znaczy „mój”."
