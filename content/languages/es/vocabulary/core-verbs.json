  "title": "Czasowniki podstawowe",
  "description": "Czasowniki, z których zbudujesz najwięcej zdań na start.",
  "items": [
    {
      "id": "es-ser",
      "status": "published",
      "order": 10,
      "lemma": "ser",
      "translation": "być (kim/czym ktoś jest)",
      "levelId": "a1",
      "partOfSpeech": "verb",
      "note": "Tożsamość, pochodzenie, zawód, cechy. Soy, eres, es…",
      "example": {
        "text": "Soy de Polonia.",
        "translation": "Jestem z Polski."
      }
    },
    {
      "id": "es-estar",
      "status": "published",
      "order": 20,
      "lemma": "estar",
      "translation": "być (gdzie, w jakim stanie)",
      "levelId": "a1",
      "partOfSpeech": "verb",
      "note": "eSTAR jak STAN: położenie i stan chwilowy.",
      "example": {
        "text": "Estoy cansado.",
        "translation": "Jestem zmęczony."
      }
    },
    {
      "id": "es-tener",
      "status": "published",
      "order": 30,
      "lemma": "tener",
      "translation": "mieć",
      "levelId": "a1",
      "partOfSpeech": "verb",
      "note": "Także wiek: tengo treinta años.",
      "example": {
        "text": "Tengo dos hermanos.",
        "translation": "Mam dwóch braci."
      }
    },
    {
      "id": "es-querer",
      "status": "published",
      "order": 40,
      "lemma": "querer",
      "translation": "chcieć; kochać",
      "levelId": "a1",
      "partOfSpeech": "verb",
      "note": "Quiero + rzeczownik lub bezokolicznik.",
      "example": {
        "text": "Quiero aprender español.",
        "translation": "Chcę uczyć się hiszpańskiego."
      }
    },
    {
      "id": "es-gustar",
      "status": "published",
      "order": 50,
      "lemma": "gustar",
      "translation": "podobać się (lubić)",
      "levelId": "a1",
      "partOfSpeech": "verb",
      "note": "Zgadza się z rzeczą: me gusta el café, me gustan los libros."
    },
    {
      "id": "es-llamarse",
      "status": "published",
      "order": 60,
      "lemma": "llamarse",
      "translation": "nazywać się",
      "levelId": "a1",
      "partOfSpeech": "verb",
      "note": "Llamo brzmi jak [jamo]: wołasz imię w głąb jamy."
    },
    {
      "id": "es-trabajar",
      "status": "published",
      "order": 70,
      "lemma": "trabajar",
      "translation": "pracować",
      "levelId": "a1",
      "partOfSpeech": "verb"
    },
    {
      "id": "es-vivir",
      "status": "published",
      "order": 80,
      "lemma": "vivir",
      "translation": "mieszkać; żyć",
      "levelId": "a1",
      "partOfSpeech": "verb",
      "note": "Skojarzenie: VIVA! — krzyczysz z radości, że żyjesz w Hiszpanii."
    },
    {
      "id": "es-hablar",
      "status": "published",
