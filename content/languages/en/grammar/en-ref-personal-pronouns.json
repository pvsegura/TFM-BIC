        "rows": [
          ["I", "yo; me, mi, mío", "me", "my", "mine", "myself"],
          ["you", "tú, usted; te, tu, tuyo", "you", "your", "yours", "yourself"],
          ["he", "él; lo, le, su, suyo", "him", "his", "his", "himself"],
          ["she", "ella; la, le, su, suya", "her", "her", "hers", "herself"],
          ["it", "ello (cosa o animal)", "it", "its", "—", "itself"],
          ["we", "nosotros; nos, nuestro", "us", "our", "ours", "ourselves"],
          ["you (plural)", "vosotros, ustedes; os, vuestro", "you", "your", "yours", "yourselves"],
          ["they", "ellos, ellas; los, les, su, suyo", "them", "their", "theirs", "themselves"]
        ]
      },
      "examples": [
        {
          "text": "She loves him.",
