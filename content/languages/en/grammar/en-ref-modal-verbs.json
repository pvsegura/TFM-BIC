  "schemaVersion": 1,
  "id": "en-ref-modal-verbs",
  "languageId": "en",
  "status": "published",
  "order": 60,
  "category": "verbs",
  "instructionLanguage": "es",
  "title": "Verbos modales",
  "description": "Can, could, must, have to, should, may, might y would.",
  "sections": [
    {
      "text": "Los verbos modales no añaden -s en la tercera persona, no usan do en negativas y preguntas, y van seguidos del verbo en forma base sin to: She can swim, no She cans to swim.",
      "table": {
        "columns": ["Modal", "Significado", "Ejemplo", "En español"],
        "rows": [
          ["can", "poder, saber hacer", "I can swim.", "Sé nadar."],
          ["could", "podía; podría (petición educada)", "Could you help me?", "¿Podrías ayudarme?"],
          [
            "must",
            "deber (obligación que siente quien habla)",
            "I must study tonight.",
            "Tengo que estudiar esta noche."
          ],
          [
            "have to",
            "tener que (obligación externa)",
            "I have to work on Saturday.",
            "Tengo que trabajar el sábado."
          ],
          [
            "don't have to",
            "no hace falta",
            "You don't have to come.",
            "No hace falta que vengas."
          ],
          [
            "mustn't",
            "no se debe, está prohibido",
            "You mustn't smoke here.",
            "Aquí no se puede fumar."
          ],
          ["should", "debería (consejo)", "You should see a doctor.", "Deberías ir al médico."],
          ["may", "puede que; ¿puedo…? (formal)", "May I come in?", "¿Puedo pasar?"],
          [
            "might",
            "puede que (menos probable)",
            "It might rain later.",
            "Puede que llueva más tarde."
          ],
          ["would", "condicional: -ría", "I would like a coffee.", "Me gustaría un café."]
        ]
      }
    }
  ]
}
