  "title": "Phrasal verbs frecuentes",
  "description": "Verbo + partícula con un significado nuevo: get up, look for, give up…",
  "sections": [
    {
      "text": "Un phrasal verb combina un verbo con una partícula (up, out, off, on…) y suele tener un significado distinto del verbo solo. Son muy frecuentes en la lengua hablada.",
      "table": {
        "columns": ["Phrasal verb", "Significado", "Ejemplo", "En español"],
        "rows": [
          ["get up", "levantarse", "I get up at seven.", "Me levanto a las siete."],
          ["wake up", "despertarse", "I woke up early.", "Me desperté temprano."],
          ["look for", "buscar", "I'm looking for my keys.", "Estoy buscando mis llaves."],
          ["look after", "cuidar", "She looks after her brother.", "Cuida de su hermano."],
          ["find out", "averiguar, enterarse", "I found out the truth.", "Descubrí la verdad."],
          ["give up", "dejar, rendirse", "He gave up smoking.", "Dejó de fumar."],
          [
            "turn on / turn off",
            "encender / apagar",
            "Turn off the light, please.",
            "Apaga la luz, por favor."
          ],
          [
            "put on / take off",
            "ponerse / quitarse (ropa)",
            "Put on your coat.",
            "Ponte el abrigo."
          ],
          ["go out", "salir", "We go out on Fridays.", "Salimos los viernes."],
          ["come back", "volver", "When are you coming back?", "¿Cuándo vuelves?"],
          ["carry on", "continuar", "Carry on, please.", "Continúa, por favor."],
          ["pick up", "recoger", "I'll pick you up at eight.", "Te recojo a las ocho."]
        ]
      }
    }
  ]
}
