          ["ty", "masz", "chcesz", "możesz", "musisz", "wiesz"],
          ["on / ona / ono", "ma", "chce", "może", "musi", "wie"],
          ["my", "mamy", "chcemy", "możemy", "musimy", "wiemy"],
          ["wy", "macie", "chcecie", "możecie", "musicie", "wiecie"],
          ["oni / one", "mają", "chcą", "mogą", "muszą", "wiedzą"]
