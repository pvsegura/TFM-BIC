      }
    },
    {
      "table": {
        "caption": "Comer, beber, ir a pie, ir en vehículo, saber hacer",
        "columns": ["Persona", "jeść", "pić", "iść", "jechać", "umieć"],
        "rows": [
          ["ja", "jem", "piję", "idę", "jadę", "umiem"],
          ["ty", "jesz", "pijesz", "idziesz", "jedziesz", "umiesz"],
          ["on / ona / ono", "je", "pije", "idzie", "jedzie", "umie"],
          ["my", "jemy", "pijemy", "idziemy", "jedziemy", "umiemy"],
