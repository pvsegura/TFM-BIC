  "title": "Past tense",
  "description": "Past tense endings by person and gender, with the common irregular forms.",
  "sections": [
    {
      "text": "The past tense is the verb stem plus -ł- and a personal ending. In the singular the ending shows gender; in the plural, -li is used for any group with at least one man, and -ły for all other groups.",
      "table": {
        "columns": ["Person", "być (to be)", "robić (to do)"],
        "rows": [
          ["ja (I), man", "byłem", "robiłem"],
          ["ja (I), woman", "byłam", "robiłam"],
          ["ty (you), to a man", "byłeś", "robiłeś"],
          ["ty (you), to a woman", "byłaś", "robiłaś"],
          ["on (he)", "był", "robił"],
          ["ona (she)", "była", "robiła"],
          ["ono (it)", "było", "robiło"],
          ["my (we), with men", "byliśmy", "robiliśmy"],
          ["my (we), women only", "byłyśmy", "robiłyśmy"],
          ["wy (you, plural), with men", "byliście", "robiliście"],
          ["wy (you, plural), women only", "byłyście", "robiłyście"],
          ["oni (they), with men", "byli", "robili"],
          ["one (they), no men", "były", "robiły"]
        ]
      }
    },
    {
      "heading": "Irregular past forms",
      "table": {
        "columns": [
          "Verb",
          "I (man)",
          "I (woman)",
          "he",
          "she",
          "they (with men)",
          "they (no men)"
        ],
        "rows": [
          ["iść (to go)", "szedłem", "szłam", "szedł", "szła", "szli", "szły"],
          ["jeść (to eat)", "jadłem", "jadłam", "jadł", "jadła", "jedli", "jadły"],
          ["móc (can)", "mogłem", "mogłam", "mógł", "mogła", "mogli", "mogły"],
          ["mieć (to have)", "miałem", "miałam", "miał", "miała", "mieli", "miały"],
          ["chcieć (to want)", "chciałem", "chciałam", "chciał", "chciała", "chcieli", "chciały"],
          ["wziąć (to take)", "wziąłem", "wzięłam", "wziął", "wzięła", "wzięli", "wzięły"]
        ]
      },
      "examples": [
        {
          "text": "Wczoraj byłam w pracy.",
          "translation": "Yesterday I was at work.",
          "note": "Said by a woman."
        },
        {
          "text": "Szedłem do domu.",
          "translation": "I was walking home.",
          "note": "Said by a man."
        }
      ]
    }
  ]
}
