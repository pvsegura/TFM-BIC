  "title": "Verbs of motion",
  "description": "Iść and chodzić on foot, jechać and jeździć by vehicle, in the present tense.",
  "sections": [
    {
      "text": "Iść and jechać describe one trip in one direction, often happening now. Chodzić and jeździć describe habits, repeated trips or round trips. Iść and chodzić are on foot; jechać and jeździć are by vehicle.",
      "table": {
        "columns": [
          "Person",
          "iść (go on foot, once)",
          "chodzić (go on foot, regularly)",
          "jechać (go by vehicle, once)",
          "jeździć (go by vehicle, regularly)"
        ],
        "rows": [
          ["ja (I)", "idę", "chodzę", "jadę", "jeżdżę"],
          ["ty (you, one person)", "idziesz", "chodzisz", "jedziesz", "jeździsz"],
          ["on / ona / ono (he / she / it)", "idzie", "chodzi", "jedzie", "jeździ"],
          ["my (we)", "idziemy", "chodzimy", "jedziemy", "jeździmy"],
          ["wy (you, several people)", "idziecie", "chodzicie", "jedziecie", "jeździcie"],
          ["oni / one (they)", "idą", "chodzą", "jadą", "jeżdżą"]
        ]
      },
      "examples": [
        {
          "text": "Teraz idę do sklepu.",
          "translation": "I am walking to the shop now."
        },
        {
          "text": "W soboty chodzę na basen.",
          "translation": "On Saturdays I go to the pool."
        },
        {
          "text": "Jutro jadę do Krakowa.",
          "translation": "Tomorrow I am going to Kraków."
        }
      ]
    }
  ]
}
