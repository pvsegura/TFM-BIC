          "sklepy (shops)",
          "studenci (students, men)",
          "kobiety (women)",
          "okna (windows)"
        ],
        "rows": [
          ["Nominative", "sklepy", "studenci", "kobiety", "okna"],
          ["Genitive", "sklepów", "studentów", "kobiet", "okien"],
          ["Dative", "sklepom", "studentom", "kobietom", "oknom"],
          ["Accusative", "sklepy", "studentów", "kobiety", "okna"],
          ["Instrumental", "sklepami", "studentami", "kobietami", "oknami"],
          ["Locative", "sklepach", "studentach", "kobietach", "oknach"]
