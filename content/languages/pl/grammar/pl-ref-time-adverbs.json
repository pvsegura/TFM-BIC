      "heading": "When",
      "table": {
        "columns": ["Polish", "English", "Example", "In English"],
        "rows": [
          ["teraz", "now", "Teraz pracuję.", "I'm working now."],
          ["dzisiaj, dziś", "today", "Dzisiaj jest poniedziałek.", "Today is Monday."],
          ["jutro", "tomorrow", "Jutro mam egzamin.", "I have an exam tomorrow."],
          [
            "pojutrze",
            "the day after tomorrow",
            "Wracam pojutrze.",
            "I'm coming back the day after tomorrow."
