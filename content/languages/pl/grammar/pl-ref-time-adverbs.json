    {
      "heading": "How often",
      "text": "Frequency adverbs usually come before the verb. Nigdy (never) needs nie before the verb: Polish uses a double negative.",
      "table": {
        "columns": ["Polish", "English", "Example", "In English"],
        "rows": [
          ["zawsze", "always", "Zawsze jem śniadanie.", "I always have breakfast."],
          [
            "zwykle, zazwyczaj",
            "usually",
            "Zwykle wstaję o siódmej.",
            "I usually get up at seven."
          ],
          ["często", "often", "Często chodzę do kina.", "I often go to the cinema."],
          ["czasem, czasami", "sometimes", "Czasem gotuję.", "Sometimes I cook."],
          ["rzadko", "rarely", "Rzadko oglądam telewizję.", "I rarely watch TV."],
          ["nigdy", "never", "Nigdy nie piję kawy.", "I never drink coffee."],
          [
            "codziennie",
            "every day",
            "Codziennie czytam gazetę.",
            "I read the newspaper every day."
          ],
          ["co tydzień", "every week", "Co tydzień dzwonię do mamy.", "I call my mum every week."]
        ]
      }
