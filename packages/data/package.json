{
  "name": "@tfm-bic/data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --emitDeclarationOnly",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:generate:profile": "drizzle-kit generate --config drizzle.profile.config.ts",
    "db:migrate:profile": "drizzle-kit migrate --config drizzle.profile.config.ts",
    "db:generate:lessons": "drizzle-kit generate --config drizzle.lessons.config.ts",
    "db:migrate:lessons": "drizzle-kit migrate --config drizzle.lessons.config.ts",
    "db:generate:exercises": "drizzle-kit generate --config drizzle.exercises.config.ts",
    "db:migrate:exercises": "drizzle-kit migrate --config drizzle.exercises.config.ts",
    "db:generate:gamification": "drizzle-kit generate --config drizzle.gamification.config.ts",
    "db:migrate:gamification": "drizzle-kit migrate --config drizzle.gamification.config.ts",
    "db:generate:vocabulary": "drizzle-kit generate --config drizzle.vocabulary.config.ts",
    "db:migrate:vocabulary": "drizzle-kit migrate --config drizzle.vocabulary.config.ts",
    "db:generate:video": "drizzle-kit generate --config drizzle.video.config.ts",
    "db:migrate:video": "drizzle-kit migrate --config drizzle.video.config.ts",
    "content:validate": "tsx src/content/validate-content.cli.ts"
  },
  "dependencies": {
    "@tfm-bic/application": "workspace:*",
    "@tfm-bic/contracts": "workspace:*",
    "@tfm-bic/domain": "workspace:*",
    "argon2": "0.45.1",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/pg": "8.15.5",
    "drizzle-kit": "0.31.10",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
