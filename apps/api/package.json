{
  "name": "@tfm-bic/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "start:test": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node build.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@tfm-bic/application": "workspace:*",
    "@tfm-bic/config": "workspace:*",
    "@tfm-bic/contracts": "workspace:*",
    "@tfm-bic/data": "workspace:*",
    "@tfm-bic/domain": "workspace:*",
    "argon2": "0.45.1",
    "fastify": "^5.12.4"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "esbuild": "0.28.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
